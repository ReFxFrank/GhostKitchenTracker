# Copy to .env at repo root. docker-compose reads it via env_file/variable interpolation.

# Postgres (docker-compose defaults match these)
POSTGRES_DB=seance
POSTGRES_USER=seance
POSTGRES_PASSWORD=seance-dev-only
DATABASE_URL=postgres://seance:seance-dev-only@db:5432/seance

# Socrata app token — free, register at https://data.cityofnewyork.us/profile/edit/developer_settings
# Unauthenticated requests are throttled hard. Required for Phase 1 ingest.
SOCRATA_APP_TOKEN=
